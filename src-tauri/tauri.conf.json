{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saga",
  "version": "0.1.0",
  "identifier": "com.falcighol.saga",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Saga",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 },
        "backgroundColor": "#0F1012"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A fast, smart sample browser",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Source/Saga.icon"
    ]
  }
}
